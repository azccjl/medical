-rwxr-xr-x 1 root root 1060 Oct 11 18:08 /usr/local/sbin/medical_clock_boot_guard.py
# Only the Ubuntu VM is the clock authority. No public NTP fallback.
server 192.168.12.71 iburst minpoll 0 maxpoll 2 maxdelay 0.05
driftfile /var/lib/chrony/chrony.drift
logdir /var/log/chrony
cmdport 0
# Exit on a large offset; do not propagate a reboot/date error into ROS.
maxchange 0.5 0 0
# Slew only. There is deliberately no makestep directive.
maxslewrate 10000
[Service]
ExecStartPre=/usr/bin/python2 /usr/local/sbin/medical_clock_boot_guard.py
