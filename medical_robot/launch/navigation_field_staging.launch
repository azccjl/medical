<launch>
  <!-- On-site prerequisite: map_server, AMCL and validated sensor/odom inputs. -->
  <!-- Planning output is isolated: no bridge or base driver in this launch. -->
  <node pkg="move_base" type="move_base" name="medical_field_move_base" output="screen" required="true">
    <rosparam file="$(find medical_robot)/config/navigation/costmap_common.yaml" command="load" ns="global_costmap" />
    <rosparam file="$(find medical_robot)/config/navigation/costmap_common.yaml" command="load" ns="local_costmap" />
    <rosparam file="$(find medical_robot)/config/navigation/global_costmap.yaml" command="load" ns="global_costmap" />
    <rosparam file="$(find medical_robot)/config/navigation/local_costmap.yaml" command="load" ns="local_costmap" />
    <rosparam file="$(find medical_robot)/config/navigation/teb_field_candidate.yaml" command="load" />
    <param name="base_global_planner" value="navfn/NavfnROS" />
    <param name="base_local_planner" value="teb_local_planner/TebLocalPlannerROS" />
    <param name="recovery_behavior_enabled" value="false" />
    <param name="clearing_rotation_allowed" value="false" />
    <param name="controller_frequency" value="10.0" />
    <param name="controller_patience" value="3.0" />
    <remap from="cmd_vel" to="/medical_field_candidate/cmd_vel" />
    <remap from="move_base_simple/goal" to="/medical_field_candidate/simple_goal" />
  </node>
</launch>
